      "id": "1b5a7c5d-1f01-4c51-9001-000000000012",
      "name": "Return Saved Document"
    },
    {
      "parameters": {
        "jsCode": "// AI Agent เป็นตัวจัดข้อมูลหลัก ส่วนโค้ดนี้ตรวจค่าที่ชัดเจนจาก OCR ก่อนบันทึก\nconst document = { ...$json.output };\nconst ocrText = $('Typhoon OCR').first().json.text || '';\nconst compactOcr = ocrText.replace(/\\s+/g, '');\n\n// หัวเอกสารจริงสำคัญกว่าชื่อไฟล์ เพราะชื่อไฟล์อาจตั้งผิด\nlet detectedType = null;\nif (compactOcr.includes('ใบเสร็จรับเงิน')) detectedType = 'RECEIPT';\nelse if (compactOcr.includes('ใบวางบิล')) detectedType = 'BILLING_NOTE';\nelse if (compactOcr.includes('ใบแจ้งหนี้') || compactOcr.includes('ใบแจ้งหนี')) detectedType = 'INVOICE';\nelse if (compactOcr.includes('ใบเสนอราคา')) detectedType = 'QUOTATION';\nif (detectedType) document.document_type = detectedType;\n\nconst isBillingNote = document.document_type === 'BILLING_NOTE';\n\n// แปลงวันที่ไทย เช่น 15-6-69 เป็น 2026-06-15\nfunction normalizeThaiDate(value) {\n  if (!value) return null;\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return value;\n\n  const parts = String(value).trim().split(/[-/]/).map(Number);\n  if (parts.length !== 3 || parts.some(Number.isNaN)) return null;\n\n  const [day, month, rawYear] = parts;\n  const year = rawYear < 100\n    ? rawYear + 1957\n    : (rawYear > 2400 ? rawYear - 543 : rawYear);\n\n  return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;\n}\n\n// ถ้า AI ไม่คืนรายการใบวางบิล ให้ดึงจากแถวตาราง HTML ที่ Typhoon OCR คืนมา\nif (isBillingNote) {\n  document.document_type = 'BILLING_NOTE';\n  document.items = [];\n\n  if (!Array.isArray(document.billing_note_entries) || document.billing_note_entries.length === 0) {\n    const entries = [];\n    const rowPattern = /<tr><td>\\s*(\\d+)\\s*<\\/td><td>(.*?)<\\/td><td>(.*?)<\\/td><td>(.*?)<\\/td><td>\\s*([\\d,]+)\\s*<\\/td><\\/tr>/gis;\n\n    for (const match of ocrText.matchAll(rowPattern)) {\n      const clean = (text) => text.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n\n      entries.push({\n        line_number: Number(match[1]),\n        purchase_order_contract_no: clean(match[2]) || null,\n        invoice_number: clean(match[3]) || null,\n        invoice_date: normalizeThaiDate(clean(match[4])),\n        amount: Number(match[5].replace(/,/g, ''))\n      });\n    }\n\n    document.billing_note_entries = entries;\n  }\n}\n\n// ถ้า AI มองข้ามเลขเอกสาร แต่ OCR อ่านรูปแบบ IV/QT/QU/RC ได้ชัด ให้ใช้ค่านั้น\nif (!document.document_number) {\n  const documentNumber = ocrText.match(/\\b(?:IV|QT|QU|RC)[A-Z0-9-]{4,}\\b/i);\n  if (documentNumber) document.document_number = documentNumber[0].toUpperCase();\n}\n\n// ป้องกัน AI นำชื่อไฟล์หรือหัวตารางมาใช้เป็นเลขเอกสาร\nif (document.document_number && (/\\.pdf$/i.test(document.document_number) || /^(QUANTITY|DESCRIPTION|TOTAL|AMOUNT)$/i.test(document.document_number))) {\n  document.document_number = null;\n}\n\n// ถ้าช่องยอดรวมใน OCR ไม่มีตัวเลข ห้ามให้ AI คำนวณยอดขึ้นมาเอง\nconst upperOcr = ocrText.toUpperCase();\nconst totalLabelIndex = Math.max(upperOcr.lastIndexOf('AMOUNT'), upperOcr.lastIndexOf('TOTAL'));\nconst totalTail = totalLabelIndex >= 0 ? ocrText.slice(totalLabelIndex, totalLabelIndex + 160) : '';\nif (!/\\d[\\d,]*(?:\\.\\d+)?/.test(totalTail)) document.total_amount = null;\n\n// ตรวจข้อมูลจำเป็นและความสัมพันธ์ระหว่างยอดรวมกับยอดของแต่ละแถว\nconst rows = isBillingNote ? (document.billing_note_entries || []) : (document.items || []);\nconst rowTotals = rows.map((row) => isBillingNote ? row.amount : row.line_total);\nconst canCompareTotals = rows.length > 0 && rowTotals.every((value) => typeof value === 'number');\nconst calculatedTotal = canCompareTotals ? rowTotals.reduce((sum, value) => sum + value, 0) : null;\nconst totalMismatch = calculatedTotal !== null && document.total_amount !== null && Math.abs(calculatedTotal - document.total_amount) > 0.01;\nconst documentNumberMissing = !isBillingNote && !document.document_number;\n\ndocument.processing_status = (\n  documentNumberMissing ||\n  !document.issue_date ||\n  !document.vendor_info?.name ||\n  !document.customer_info?.name ||\n  document.total_amount == null ||\n  totalMismatch\n) ? 'NEEDS_REVIEW' : 'EXTRACTED';\n\nreturn [{ json: { ...$json, output: document } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        0
      ],
      "id": "1b5a7c5d-1f01-4c51-9001-000000000013",
      "name": "Fix Billing Note Rows"
