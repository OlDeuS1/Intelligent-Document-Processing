    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "date-normalized",
              "name": "normalized_issue_date",
              "value": "={{ (() => { const value = $json.output.issue_date; if (!value) return null; if (/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(value))) return value; const parts = String(value).split(/[-/]/).map(Number); if (parts.length !== 3 || parts.some(Number.isNaN)) return null; const day = parts[0]; const month = parts[1]; const rawYear = parts[2]; const year = rawYear < 100 ? rawYear + 1957 : (rawYear > 2400 ? rawYear - 543 : rawYear); return String(year) + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); })() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
