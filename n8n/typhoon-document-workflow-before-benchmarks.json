    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"document_type\",\n    \"vendor_info\",\n    \"customer_info\",\n    \"document_number\",\n    \"issue_date\",\n    \"items\",\n    \"total_amount\",\n    \"amount_text\",\n    \"billing_note_entries\"\n  ],\n  \"properties\": {\n    \"document_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"QUOTATION\",\n        \"INVOICE\",\n        \"BILLING_NOTE\",\n        \"RECEIPT\"\n      ]\n    },\n    \"vendor_info\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"name\",\n        \"address\",\n        \"phone\"\n      ],\n      \"properties\": {\n        \"name\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"address\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"phone\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        }\n      }\n    },\n    \"customer_info\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"name\",\n        \"address\",\n        \"tax_id\",\n        \"branch_code\",\n        \"phone\"\n      ],\n      \"properties\": {\n        \"name\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"address\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"tax_id\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"branch_code\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"phone\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        }\n      }\n    },\n    \"document_number\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"issue_date\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"line_number\",\n          \"description\",\n          \"quantity\",\n          \"unit\",\n          \"goods_unit_price\",\n          \"labor_unit_price\",\n          \"line_total\"\n        ],\n        \"properties\": {\n          \"line_number\": {\n            \"type\": \"integer\"\n          },\n          \"description\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"quantity\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"unit\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"goods_unit_price\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"labor_unit_price\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"line_total\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          }\n        }\n      }\n    },\n    \"total_amount\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"amount_text\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"billing_note_entries\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"line_number\",\n          \"invoice_number\",\n          \"invoice_date\",\n          \"purchase_order_contract_no\",\n          \"amount\"\n        ],\n        \"properties\": {\n          \"line_number\": {\n            \"type\": \"integer\"\n          },\n          \"invoice_number\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"invoice_date\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"purchase_order_contract_no\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"amount\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          }\n        }\n      }\n    }\n  }\n}"
      },
